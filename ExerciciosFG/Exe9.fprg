    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="salario" type="Real" array="False" size=""/>
            <declare name="salarioAumento" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor bruto do salario: &quot;" newline="True"/>
            <input variable="salario"/>
            <assign variable="salarioAumento" expression="salario + (salario  * 0.15)"/>
            <output expression="&quot;O salario: &quot; &amp; salario &amp; &quot; com 15% de aumento &#233;: &quot;&amp; salarioAumento" newline="True"/>
        </body>
    </function>
