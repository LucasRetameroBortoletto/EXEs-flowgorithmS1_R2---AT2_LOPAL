    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="altura" type="Real" array="False" size=""/>
            <declare name="largura" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a altura do retangulo: &quot;" newline="True"/>
            <input variable="altura"/>
            <output expression="&quot;Digite a largura do retangulo: &quot;" newline="True"/>
            <input variable="largura"/>
            <declare name="area" type="Real" array="False" size=""/>
            <assign variable="area" expression="altura * largura"/>
            <output expression="&quot;A area do retangulo &#233; &quot; &amp; area" newline="True"/>
        </body>
    </function>
