    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valorProduto" type="Real" array="False" size=""/>
            <declare name="valorPromocao" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor bruto do produto: &quot;" newline="True"/>
            <input variable="valorProduto"/>
            <assign variable="valorPromocao" expression="valorProduto - (valorProduto  * 0.05)"/>
            <output expression="&quot;O valor: &quot; &amp; valorProduto &amp; &quot; com 5% de desconto &#233;: &quot;&amp; valorPromocao" newline="True"/>
        </body>
    </function>
</flowgorithm>
