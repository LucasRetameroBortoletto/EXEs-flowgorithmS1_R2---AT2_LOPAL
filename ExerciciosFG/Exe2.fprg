    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero1" type="Real" array="False" size=""/>
            <declare name="numero2" type="Real" array="False" size=""/>
            <declare name="numero3" type="Real" array="False" size=""/>
            <declare name="media" type="Real" array="False" size=""/>
            <output expression="&quot;Escreva um valor: &quot;" newline="True"/>
            <input variable="numero1"/>
            <output expression="&quot;Escreva um valor: &quot;" newline="True"/>
            <input variable="numero2"/>
            <output expression="&quot;Escreva um valor: &quot;" newline="True"/>
            <input variable="numero3"/>
            <assign variable="media" expression="(numero1 + numero2 + numero3) / 3"/>
            <output expression="&quot;A media entre &quot; &amp; numero1 &amp; &quot; &quot; &amp;  numero2 &amp; &quot; &quot; &amp;  numero3 &amp; &quot; &#233; igual a &quot; &amp; media" newline="True"/>
        </body>
    </function>
