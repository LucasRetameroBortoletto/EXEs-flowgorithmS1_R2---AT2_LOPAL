    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="diasTrabalhados" type="Integer" array="False" size=""/>
            <declare name="salario" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o numero de dias trabalhados: &quot;" newline="True"/>
            <input variable="diasTrabalhados"/>
            <assign variable="salario" expression="( 6 * diasTrabalhados * 45)"/>
            <output expression="&quot;O salario ao fim do mes sera de: &quot; &amp; salario" newline="True"/>
        </body>
    </function>
